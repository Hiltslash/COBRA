#! /usr/bin/env python3

from colorama import Style
from colorama import Fore as tc
import sys
import shlex

arguments = sys.argv
if len(arguments) != 2:
    print(tc.RED + "USAGE: cobra <file_path.coil>" + Style.RESET_ALL)
    exit(1)
elif not arguments[1].endswith(".coil"):
    print(tc.RED + "You can only run .coil scripts made for Cobra." + Style.RESET_ALL)
    exit(1)

def loadFile(source):
    with open(source, "r") as file:
        return file.readlines()

class cobra:
    def __init__(self):
        self.commands = {
            "show": self.show,
            "let": self.let
        }

    def show(self, arguments):
        if len(arguments) == 2:
            #print(arguments[1]) # -- DEBUG -- #
            color = self.convertStringToColor(arguments[1])
            print(color + arguments[0] + Style.RESET_ALL)
        elif len(arguments) == 1:
            print(arguments[0])
        else:
            print(tc.RED + f"KEYWORD SHOW REQUIRES 1, TAKES 2 ARGUMENTS, {len(arguments)} GIVEN." + Style.RESET_ALL)


    def convertStringToColor(self, string: str):
        if string.lower() == "red":
            return tc.RED
        elif string.lower() == "blue":
            return tc.BLUE
        elif string.lower() == "green":
            return tc.GREEN
        elif string.lower() == "yellow":
            return tc.YELLOW
    def let(self, arguments):
        pass

src = arguments[1]
scriptlines = loadFile(src)

def main():
    global scriptlines
    Cobra = cobra()
    
    for line in scriptlines:

        line = line.strip()
        sectors = shlex.split(line)
        command = sectors[0]
        arguments = sectors[1:]

        # --- DEBUG --- #
        #print(sectors)
        #print(command)
        #print(arguments)


        if command in Cobra.commands:
            #print("Command found.") # --- DEBUG --- #
            Cobra.commands[command](arguments)

if __name__ == "__main__":
    main()

